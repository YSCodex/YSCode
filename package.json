{
  "name": "ys-code-agent",
  "version": "1.0.0",
  "description": "Production-grade AI Terminal Coding Agent",
  "main": "dist/cli/index.cjs",
  "type": "module",
  "bin": {
    "ys": "./dist/cli/index.cjs"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "dev": "tsx watch src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs --testPathPattern=unit",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs --testPathPattern=integration",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["ai", "coding-agent", "cli", "code-assistant", "terminal"],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.3",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.12.0",

    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
