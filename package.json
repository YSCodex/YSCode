{
  "name": "ys-code-agent",
  "version": "2.0.1",
  "description": "Production-grade AI Terminal Coding Assistant — Built for Termux, Engineered for Production. 40+ slash commands, multi-provider AI, git integration, autonomous mode.",
  "main": "dist/cli/index.cjs",
  "type": "module",
  "bin": {
    "ys": "dist/cli/index.cjs"
  },
  "files": [
    "dist/",
    "scripts/",
    "README.md",
    "SETUP.md",
    "USAGE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "dev": "tsx watch src/cli/index.ts",
    "start": "node dist/cli/index.cjs",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs --testPathPattern=unit",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs --testPathPattern=integration",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "code-assistant",
    "terminal",
    "termux",
    "android",
    "claude-code",
    "qwen-code",
    "gemini-cli",
    "openrouter",
    "gpt",
    "code-review",
    "autonomous"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YSCodex/YSCode.git"
  },
  "bugs": {
    "url": "https://github.com/YSCodex/YSCode/issues"
  },
  "homepage": "https://github.com/YSCodex/YSCode#readme",
  "author": "YS Codex <yscodex@github.com>",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/YSCodex"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.3",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.12.0",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
